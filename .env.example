# ========================================
# NORA (Neural Orchestration & Research Assistant) Configuration
# ========================================
# Copy this file to .env and configure your settings

# ========================================
# LLM Provider Configuration
# ========================================

# LLM Provider: "llama_cpp" (default, direct GGUF inference) or "ollama"
LLM_PROVIDER=llama_cpp

# ----------------------------------------
# Llama.cpp Configuration (default)
# ----------------------------------------
# Absolute path to your GGUF model file
# Example: /Users/you/models/qwen2.5-7b-instruct.Q4_K_M.gguf
# Leave empty if using Ollama
LLAMA_MODEL_PATH=

# Context window size (tokens)
LLAMA_CONTEXT_SIZE=8192

# Maximum tokens to generate per response
LLAMA_MAX_TOKENS=2048

# Number of GPU layers to offload (0 = CPU only, -1 = all layers)
# Requires llama-cpp-python built with GPU support
LLAMA_GPU_LAYERS=0

# CPU threads (0 = auto-detect)
LLAMA_THREADS=0

# ----------------------------------------
# Ollama Configuration (optional backend)
# ----------------------------------------
# Ollama server URL
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model name (must be pulled via: ollama pull <model>)
OLLAMA_MODEL=qwen2.5:7b

# Request timeout in seconds
OLLAMA_TIMEOUT=120

# ========================================
# Workspace Configuration
# ========================================

# Directory where NORA generates projects
# Relative paths are resolved from the repository root
SWARM_WORKSPACE_PATH=./projects

# ========================================
# Memory Configuration
# ========================================

# Maximum messages in short-term memory
MAX_SHORT_TERM_MESSAGES=50

# Vector database collection name
VECTOR_COLLECTION_NAME=swarm_knowledge

# Number of messages before triggering summarization
SUMMARIZATION_THRESHOLD=100

# Enable vector memory (requires ChromaDB)
ENABLE_VECTOR_MEMORY=false

# Vector database storage path
VECTOR_DB_PATH=./data/vector_store

# ========================================
# Tool Configuration
# ========================================

# Enable web research capabilities
ENABLE_WEB_RESEARCH=true

# Enable git operations
ENABLE_GIT_TOOLS=true

# Maximum file size for operations (MB)
MAX_FILE_SIZE_MB=10

# ========================================
# Safety Settings
# ========================================

# Require user confirmation before installing dependencies
REQUIRE_CONFIRMATION=true

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ========================================
# Agent Configuration
# ========================================

# Maximum iterations for agent workflows
MAX_AGENT_ITERATIONS=10

# Agent operation timeout (seconds)
AGENT_TIMEOUT=300

# ========================================
# Distributed Worker Configuration (Future)
# ========================================

# Enable distributed worker mode (not yet implemented)
WORKER_ENABLED=false

# Worker host address
WORKER_HOST=

# Worker port
WORKER_PORT=5000
